# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional settings
OPENAI_MODEL=gpt-5
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=3

# Optional: set true to allow downloading the embedding model on first run.
# With false, the app starts offline and uses local keyword retrieval if needed.
ALLOW_MODEL_DOWNLOAD=false

# Optional: set true after the embedding model is locally available.
ENABLE_SEMANTIC_RETRIEVAL=false
